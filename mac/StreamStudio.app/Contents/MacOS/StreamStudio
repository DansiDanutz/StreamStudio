#!/bin/bash
# StreamStudio.app — starts the studio on this Mac and opens its window.
# First run: downloads StreamStudio into ~/StreamStudio/app and sets it up (a minute or two).
# Later runs: updates it, makes sure the server is running, and opens the window.
# Logs: ~/StreamStudioData/logs. The server keeps running after the window closes
# (open the app again to get the window back; `pkill -f streamstudio` stops it).
# A server that is not the current version from this folder is replaced on start.

set -u
APPDIR="${STREAMSTUDIO_HOME:-$HOME/StreamStudio/app}"
REPO="https://github.com/DansiDanutz/StreamStudio.git"
DATA="$HOME/StreamStudioData"
LOG="$DATA/logs"
URL="http://127.0.0.1:8787"
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.cargo/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
mkdir -p "$LOG"

say()  { osascript -e "display notification \"$1\" with title \"StreamStudio\"" >/dev/null 2>&1; }
fail() { osascript -e "display alert \"StreamStudio could not start\" message \"$1\" as critical" >/dev/null 2>&1; exit 1; }
up()   { curl -s -m 1 "$URL/api/health" 2>/dev/null | grep -q '"ok":true'; }
field(){ curl -s -m 2 "$URL/api/health" 2>/dev/null | /usr/bin/python3 -c "import json,sys; print(json.load(sys.stdin).get('$1') or '')" 2>/dev/null; }
RUN="$DATA/run"; mkdir -p "$RUN"
stop_server() {
  # Our own api/worker (pid files), then any older StreamStudio still holding the port.
  for f in "$RUN"/*.pid; do [ -f "$f" ] && kill "$(cat "$f")" 2>/dev/null; rm -f "$f"; done
  for pid in $(lsof -ti tcp:8787 -sTCP:LISTEN 2>/dev/null); do
    ps -o command= -p "$pid" | grep -q streamstudio && kill "$pid" 2>/dev/null
  done
  pkill -f "streamstudio.worker.main" 2>/dev/null
  for _ in $(seq 1 20); do up || break; sleep 0.25; done
}

# 1. code: download once, then pick up the latest on every start (offline is fine)
if [ ! -d "$APPDIR/.git" ]; then
  say "First start: downloading StreamStudio…"
  mkdir -p "$(dirname "$APPDIR")"
  git clone --depth 1 "$REPO" "$APPDIR" >>"$LOG/setup.log" 2>&1 \
    || fail "Could not download StreamStudio from GitHub. Details: ~/StreamStudioData/logs/setup.log"
else
  git -C "$APPDIR" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=5 pull --ff-only >>"$LOG/setup.log" 2>&1 || true
fi
REV="$(git -C "$APPDIR" rev-parse HEAD)"

# A server already answering is kept only if it is this version, running from this folder.
if up; then
  if [ "$(field root)" = "$APPDIR" ] && [ "$(field rev)" = "$REV" ]; then
    CURRENT=1
  else
    echo "$(date '+%F %T') replacing server: root=$(field root) rev=$(field rev) → $REV" >>"$LOG/setup.log"
    say "Updating StreamStudio…"
    stop_server
  fi
fi

if [ -z "${CURRENT:-}" ]; then
  # 2. server (Python 3.12+; uv is used when installed, and fetches Python by itself), with the
  #    episode extra (OpenCV, rembg, Playwright) and Playwright's Chromium, once per revision
  if [ ! -x "$APPDIR/server/.venv/bin/python" ] || [ "$(cat "$APPDIR/server/.venv/.rev" 2>/dev/null)" != "$REV" ]; then
    say "Setting up the server (one time)…"
    cd "$APPDIR/server" || fail "Missing $APPDIR/server"
    {
      if command -v uv >/dev/null 2>&1; then
        uv venv -q -p 3.12 --allow-existing .venv && uv pip install -q -p .venv/bin/python -e ".[episode]"
      else
        PY=""
        for p in python3.14 python3.13 python3.12; do command -v "$p" >/dev/null 2>&1 && { PY="$p"; break; }; done
        [ -n "$PY" ] || { echo "no python >= 3.12"; false; } && "$PY" -m venv .venv && .venv/bin/pip install -q -e ".[episode]"
      fi
    } >>"$LOG/setup.log" 2>&1 || fail "Python 3.12 is needed. Install it with: brew install uv  (then open StreamStudio again)."
    .venv/bin/playwright install chromium >>"$LOG/setup.log" 2>&1 \
      || fail "Playwright could not download Chromium (needed for site cards). Details: ~/StreamStudioData/logs/setup.log"
    echo "$REV" > .venv/.rev
  fi

  # 3. web app (built once per version)
  if [ ! -f "$APPDIR/web/dist/index.html" ] || [ "$(cat "$APPDIR/web/dist/.rev" 2>/dev/null)" != "$REV" ]; then
    command -v npm >/dev/null 2>&1 || fail "Node.js is needed. Install it with: brew install node  (then open StreamStudio again)."
    say "Building the studio (one time)…"
    ( cd "$APPDIR/web" && npm ci --no-audit --no-fund && npm run build ) >>"$LOG/setup.log" 2>&1 \
      || fail "The web build failed. Details: ~/StreamStudioData/logs/setup.log"
    echo "$REV" > "$APPDIR/web/dist/.rev"
  fi

  # 4. start api + worker in the background
  cd "$APPDIR" || exit 1
  nohup server/.venv/bin/python -m streamstudio.api.main    >>"$LOG/api.log"    2>&1 & echo $! >"$RUN/api.pid"
  nohup server/.venv/bin/python -m streamstudio.worker.main >>"$LOG/worker.log" 2>&1 & echo $! >"$RUN/worker.pid"
  for _ in $(seq 1 60); do up && break; sleep 0.5; done
  up || fail "The server did not start. Details: ~/StreamStudioData/logs/api.log"
fi

# 5. the window: a Chromium browser in app mode (screen recording and going live need it),
#    with its own profile so capture permissions stick; otherwise the default browser.
for b in "Google Chrome" "Brave Browser" "Microsoft Edge" "Chromium" "Arc"; do
  if [ -d "/Applications/$b.app" ] || [ -d "$HOME/Applications/$b.app" ]; then
    open -na "$b" --args --app="$URL" --user-data-dir="$DATA/window" --no-first-run --no-default-browser-check
    exit 0
  fi
done
open "$URL"
