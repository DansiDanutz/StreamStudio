<script>
const C=CUE, D=TIMING.duration, root=document.getElementById("film");
const tl=gsap.timeline({paused:true});
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const el=(html,parent=root)=>{parent.insertAdjacentHTML("beforeend",html);return parent.lastElementChild};
const NS="http://www.w3.org/2000/svg";
const svgEl=(tag,attrs,parent)=>{const e=document.createElementNS(NS,tag);for(const k in attrs)e.setAttribute(k,attrs[k]);parent&&parent.appendChild(e);return e};
function drawOn(path,at,dur=0.6,ease="power2.out"){const L=path.getTotalLength();gsap.set(path,{strokeDasharray:L,strokeDashoffset:L,opacity:0});tl.set(path,{opacity:1},at);tl.to(path,{strokeDashoffset:0,duration:dur,ease},at);return L}
function hand(text,x,y,at,{rot=-4,size=50,arrow=null}={}){
 const h=el(`<div class="hand" style="left:${x}px;top:${y}px;font-size:${size}px;transform:rotate(${rot}deg)">${text}</div>`);
 tl.fromTo(h,{opacity:0,clipPath:"inset(0 100% 0 0)"},{opacity:1,clipPath:"inset(0 0% 0 0)",duration:.6,ease:"power1.out"},at);
 let s=null;
 if(arrow){s=svgEl("svg",{class:"draw",width:1920,height:1080,viewBox:"0 0 1920 1080",style:"left:0;top:0"},root);
  drawOn(svgEl("path",{d:arrow},s),at+.35,.5);
  const [x1,y1,x2,y2]=arrow.match(/-?\d+(\.\d+)?/g).map(Number).slice(-4), a=Math.atan2(y2-y1,x2-x1), L=18;
  const hd=svgEl("path",{d:`M${x2-L*Math.cos(a-0.5)} ${y2-L*Math.sin(a-0.5)} L${x2} ${y2} L${x2-L*Math.cos(a+0.5)} ${y2-L*Math.sin(a+0.5)}`},s);
  gsap.set(hd,{opacity:0});tl.to(hd,{opacity:1,duration:.1},at+.8)}
 return [h,s];
}
const fadeOut=(nodes,at,dur=.35)=>nodes.flat().filter(Boolean).forEach(n=>tl.to(n,{opacity:0,duration:dur},at));
const attrTween=(node,from,to,dur,at,fn,ease="power2.inOut")=>{const o={v:from};tl.to(o,{v:to,duration:dur,ease,onUpdate:()=>node.setAttribute("transform",fn(o.v))},at)};
function ask(n,text,at,until){
 const block=el(`<div class="qblk" style="position:absolute;left:96px;top:78px;z-index:30;opacity:0;max-width:1250px"><small style="display:block;font:20px Mono;letter-spacing:.22em;margin-bottom:12px">QUESTION ${String(n).padStart(2,"0")}</small><h2 style="margin:0;font:italic 64px/1.05 News;letter-spacing:-.02em">${[...text].map(c=>`<span style="opacity:0">${c}</span>`).join("")}<i style="display:inline-block;width:3px;height:52px;background:#f0783c;margin-left:6px;vertical-align:-6px"></i></h2></div>`);
 tl.to(block,{opacity:1,duration:.2},at);
 tl.to(block.querySelectorAll("h2 span"),{opacity:1,duration:.01,stagger:Math.min(.045,1.1/text.length)},at+.1);
 tl.to(block.querySelector("i"),{opacity:0,duration:.01,repeat:Math.max(1,Math.floor((until-at)/.5)),yoyo:true,repeatDelay:.25},at);
 tl.to(block,{opacity:0,y:-16,duration:.3},until-.3);
 return block;
}
const spot=$("#spot");
const light=(x,y,at,dur=.9,op=1)=>tl.to(spot,{x:x-990,y:y-540,opacity:op,duration:dur,ease:"power2.inOut"},at);
const silhouette=(node,at,reveal)=>{
 tl.fromTo(node,{filter:"brightness(0) drop-shadow(0 0 2px #ffcf9a)"},{filter:"brightness(0) drop-shadow(0 0 2px #ffcf9a)",duration:.01,immediateRender:false},at);
 tl.to(node,{filter:"brightness(1) drop-shadow(0 0 0px #ffcf9a)",duration:.9,ease:"power2.out"},reveal)};

/* ---------------- TIME MACHINE: the past is warm film, the present is a hard cut ---------------- */
const stage=$("#stage"), year=$("#year"), yb=year.querySelector("b");
const PAST="sepia(.5) saturate(.8) contrast(1.06) brightness(.96)";
tl.fromTo(stage,{filter:"sepia(0) saturate(1) contrast(1) brightness(1)"},{filter:PAST,duration:1.2},C.shrink);
tl.fromTo(["#grain","#leak"],{opacity:0},{opacity:i=>i?.3:.22,duration:1.2},C.shrink);
tl.fromTo("#paper",{opacity:0},{opacity:1,duration:1.0},C.shrink-.1);
tl.set(root,{attr:{class:"past"}},C.shrink);
tl.set("#paper",{opacity:0},C.present);
tl.set(root,{attr:{class:""}},C.present);
tl.to(year,{opacity:1,duration:.4},C.shrink+.2);
const yr={y:2026};
const roll=(to,at,dur=1.1)=>tl.to(yr,{y:to,duration:dur,ease:"power3.out",onUpdate:()=>{yb.textContent=Math.round(yr.y)}},at);
roll(1979,C.shrink+.2,1.4);
roll(1984,C.letterIn+.1,.7);
roll(1969,C.radioIn+.1,1.0);
roll(1975,C.recordIn+.1,.7);
// NOW — no transition. One frame: the present.
tl.set(stage,{filter:"none"},C.present);
tl.set(["#grain","#leak","#flicker"],{opacity:0},C.present);
roll(2026,C.present,.001);
tl.set(year.querySelector("small"),{textContent:"TODAY"},C.present);
tl.set(year,{attr:{class:"now"}},C.present);
tl.fromTo("#flash",{opacity:.9},{opacity:0,duration:.35,ease:"power2.out",immediateRender:false},C.present);
tl.to(year,{opacity:0,duration:.5},C.absorb);

/* ---------------- PRESENTER: one continuous take ---------------- */
const P=$("#presenter"), PIP={left:48,top:632,width:280,height:400,borderRadius:26};
tl.set(P,{left:0,top:0,width:1920,height:1080,borderRadius:0},0);
tl.to(P,{...PIP,duration:1.05,ease:"power3.inOut"},C.shrink);
tl.to(P,{left:820,top:0,width:1100,height:1080,borderRadius:0,duration:1.0,ease:"power3.inOut"},C.danBig);
tl.to(P,{...PIP,duration:1.0,ease:"power3.inOut"},C.danBack);
tl.set(spot,{x:0,y:0},0);
tl.to(spot,{opacity:1,duration:.8},C.shrink+.2);

/* ---------------- 01  How did you dial a number? ---------------- */
const T=$("#art-telephone");
ask(1,"How did we call our parents?",C.shrink+.3,C.letterIn+.1);
tl.fromTo(T,{opacity:0,scale:.9,y:40},{opacity:1,scale:1,y:0,duration:1.0,ease:"power3.out"},C.phoneIn);
silhouette(T,C.phoneIn,C.phoneIn+.5);
const wheel=$("#tel-wheel"), finger=$("#tel-finger");
tl.fromTo(finger,{opacity:0,x:-120,y:160},{opacity:1,x:0,y:0,duration:.55,ease:"power2.out"},C.finger);
const wind=Math.max(.6,C.ret-C.wind-.1);
tl.to([wheel,finger],{rotation:230,svgOrigin:"500 450",duration:wind,ease:"power1.inOut"},C.wind);
tl.to(finger,{opacity:0,x:"-=60",y:"+=80",duration:.3},C.ret);
for(let i=0;i<7;i++) tl.to(wheel,{rotation:230-(i+1)*230/7,svgOrigin:"500 450",duration:.1,ease:"steps(1)"},C.ret+.08+i*.1);
const a1=hand("all the way to the stop…",1270,640,C.wind+.2,{rot:-4,size:48,arrow:"M1300 640 Q1210 560 1140 560"});
tl.to(T,{opacity:0,scale:.8,y:-60,duration:.6,ease:"power2.in"},C.letterIn-.1);
fadeOut(a1,C.letterIn-.2);

/* ---------------- 02  How did you write a letter? ---------------- */
const L=$("#art-letter");
ask(2,"How did you write a letter?",C.letterIn+.15,C.radioIn);
light(990,600,C.letterIn,.8);
tl.fromTo(L,{opacity:0,y:420,rotation:-8},{opacity:1,y:0,rotation:0,duration:.9,ease:"power3.out"},C.letterIn);
silhouette(L,C.letterIn,C.letterIn+.45);
tl.fromTo("#let-post",{opacity:0,scale:1.6,svgOrigin:"600 500"},{opacity:1,scale:1,svgOrigin:"600 500",duration:.18,ease:"power4.in"},C.post);
const flapC=$("#let-flapC"), flapO=$("#let-flapO"), sheet=$("#let-sheet");
gsap.set(flapO,{scaleY:0,svgOrigin:"500 332"});gsap.set(sheet,{y:380});
tl.to(flapC,{scaleY:0,svgOrigin:"500 332",duration:.22,ease:"power2.in"},C.flap);
tl.to(flapO,{scaleY:1,svgOrigin:"500 332",duration:.25,ease:"power2.out"},C.flap+.22);
tl.to(sheet,{y:0,duration:1.1,ease:"power2.out"},C.slide);
tl.to("#let-title-rect",{attr:{width:420},duration:.9,ease:"none"},C.slide+.8);
$$("#let-ink path").forEach((p,i)=>drawOn(p,C.slide+1.4+i*.2,.42,"none"));
const a2=hand("by hand ♥",1380,190,C.loved,{rot:-5,size:56,arrow:"M1400 250 Q1300 300 1220 310"});
const counter=$(".counter"), cnum=counter.querySelector("span");
tl.fromTo(counter,{opacity:0,y:-30,rotation:8},{opacity:1,y:0,rotation:4,duration:.45,ease:"back.out(1.6)"},C.waitStart);
const days={d:1};
tl.to(days,{d:21,duration:Math.max(.8,C.waitEnd-C.waitStart-.2),ease:"power1.in",onUpdate:()=>{cnum.textContent=Math.round(days.d)}},C.waitStart+.2);
tl.to(L,{opacity:0,x:-500,rotationY:-35,scale:.75,duration:.6,ease:"power2.in"},C.radioIn-.25);
fadeOut([a2,counter],C.radioIn-.2);

/* ---------------- 03  How did we listen? ---------------- */
const Rd=$("#art-radio"), M=$("#art-moon");
ask(3,"How did we listen?",C.radioIn+.1,C.recordIn);
light(990,560,C.radioIn,.8);
tl.fromTo(Rd,{opacity:0,y:100,scale:.95},{opacity:1,y:0,scale:1,duration:.9,ease:"power3.out"},C.radioIn);
silhouette(Rd,C.radioIn,C.radioIn+.5);
const needle=$("#rad-needle"), knob=$("#rad-knob");
attrTween(needle,-18,16,.8,C.tune,v=>`rotate(${v} 500 760)`,"sine.inOut");
attrTween(needle,16,-6,.5,C.tune+.8,v=>`rotate(${v} 500 760)`,"sine.inOut");
attrTween(needle,-6,3,Math.max(.3,C.tuneLock-C.tune-1.3),C.tune+1.3,v=>`rotate(${v} 500 760)`,"power3.out");
tl.to(knob,{rotation:300,svgOrigin:"620 612",duration:Math.max(1,C.tuneLock-C.tune),ease:"sine.inOut"},C.tune);
tl.fromTo("#rad-lamp",{opacity:.35},{opacity:1,duration:.5},C.tuneLock);
// the radio steps aside: the night of 20 July 1969
tl.to(Rd,{x:-330,y:60,scale:.72,duration:.9,ease:"power3.inOut"},C.moonIn-.2);
light(1300,480,C.moonIn-.2,.9);tl.to(spot,{scale:1.5,duration:.9},C.moonIn-.2);
tl.fromTo(M,{opacity:0,scale:.85,y:-40},{opacity:1,scale:1,y:0,duration:1.0,ease:"power3.out"},C.moonIn);
tl.fromTo("#mo-disc",{y:60,opacity:.2},{y:0,opacity:1,duration:1.6,ease:"power2.out"},C.moonIn);
tl.fromTo("#mo-lander",{y:-160,opacity:0},{y:0,opacity:1,duration:1.0,ease:"power2.out"},C.moonIn+.2);
tl.fromTo("#mo-step",{opacity:0,scale:1.6,transformOrigin:"50% 50%"},{opacity:1,scale:1,duration:.2,ease:"power4.in"},C.step);
const wires=$("#wires");
for(let i=0;i<3;i++){const p=svgEl("path",{class:"radio",d:`M${1100-i*30} ${430+i*24} Q${980} ${400+i*30} ${860-i*10} ${480+i*16}`},wires);
 drawOn(p,C.step+.2+i*.18,.5);tl.to(p,{opacity:0,duration:.4},C.step+1.1+i*.18)}
const V=$("#viewers"), vb=V.querySelector("b"), vv={n:0};
tl.fromTo(V,{opacity:0,y:20},{opacity:1,y:0,duration:.4},C.viewers-.1);
tl.to(vv,{n:600000000,duration:Math.max(1,C.viewersEnd-C.viewers),ease:"power2.out",onUpdate:()=>{vb.textContent=Math.round(vv.n).toLocaleString("en-US")+(vv.n>599e6?"+":"")}},C.viewers);
tl.to([M,Rd,V],{opacity:0,y:"+=80",duration:.6,ease:"power2.in"},C.recordIn-.1);
tl.to(spot,{scale:1,duration:.7},C.recordIn-.1);

/* ---------------- 04  How did you play a song? ---------------- */
const TT=$("#art-turntable");
ask(4,"How did you play a song?",C.recordIn+.1,C.present);
light(990,540,C.recordIn,.8);
tl.fromTo(TT,{opacity:0,scale:.75,rotation:-6},{opacity:1,scale:1,rotation:0,duration:.9,ease:"power3.out"},C.recordIn);
silhouette(TT,C.recordIn,C.recordIn+.4);
const vinyl=$("#tt-vinyl"), vd={y:-300,s:1.14,o:0};
const setV=()=>{vinyl.setAttribute("transform",`translate(0 ${vd.y}) translate(440 365) scale(${vd.s}) translate(-440 -365)`);vinyl.setAttribute("opacity",vd.o)};
setV();
tl.to(vd,{o:1,duration:.25,onUpdate:setV},C.drop-.55);
tl.to(vd,{y:0,s:1,duration:.55,ease:"power2.in",onUpdate:setV},C.drop-.5);
const armRot=$$("#art-turntable .armrot"), shadow=$("#tt-armshadow");
const arm={a:0};tl.to(arm,{a:22,duration:.7,ease:"power2.inOut",onUpdate:()=>armRot.forEach(g=>g.setAttribute("transform",`rotate(${arm.a} 720 170)`))},C.needle-.75);
const lift={s:16};tl.fromTo(lift,{s:16},{s:5,duration:.3,ease:"power2.in",onUpdate:()=>shadow.setAttribute("transform",`translate(${lift.s} ${lift.s*1.1})`)},C.needle-.05);
const spinEl=$("#tt-spin"), sp={r:0}, spinDur=C.present+1-C.drop;
tl.to(sp,{r:200*spinDur,duration:spinDur,ease:"power1.in",onUpdate:()=>spinEl.setAttribute("transform",`rotate(${sp.r} 440 365)`)},C.drop+.1);
for(let i=0;i<6;i++){const n=el(`<div class="hand" style="left:${900+i*70}px;top:${330-(i%2)*30}px;font-size:${54+i%2*16}px">${i%2?"♫":"♪"}</div>`);
 tl.fromTo(n,{opacity:0,y:0,x:0},{opacity:1,y:-120,x:(i%2?18:-12),duration:.9,ease:"sine.out"},C.dance+i*.22-.4);
 tl.set(n,{opacity:0},C.present);tl.set(n,{opacity:0},C.present+1.6)}
const a4=hand("crackle…",1480,420,C.crackle,{rot:-6,size:56,arrow:"M1500 480 Q1400 520 1300 540"});

/* ---------------- NOW. Hard cut to the present ---------------- */
// every memory vanishes in a single frame
tl.set([T,L,Rd,M,TT,a4[0],a4[1],spot],{opacity:0},C.present);
const PH=$("#art-phone"), glow=$("#hub-glow");
tl.fromTo(PH,{opacity:0,scale:1.06},{opacity:1,scale:1,duration:.25,ease:"power4.out",immediateRender:false},C.present);
tl.fromTo(glow,{opacity:0},{opacity:1,duration:.6},C.present+.1);
const a5=hand("one gadget.",1220,170,C.hasAll,{rot:-5,size:60,arrow:"M1260 240 Q1220 280 1170 300"});
gsap.set($$(".ph-app"),{scale:0,transformOrigin:"50% 50%"});gsap.set($$(".ph-lbl"),{opacity:0});
// each memory comes back for a moment, in its old colours, and falls into the phone as an app
const MS=.26, minis=[[T,560,270,"call"],[L,560,790,"messages"],[Rd,1420,270,"scores"],[TT,1420,790,"music"]];
const wireKeys=["wireCall","wireLetter","wireRadio","wireMusic"];
minis.forEach(([c,x,y,app],i)=>{const at=C[wireKeys[i]];
 tl.set(c,{transformOrigin:"50% 50%",rotationY:0,rotation:0,filter:"sepia(.6) brightness(1)",x:x-990,y:y-537,scale:MS},at-.45);
 tl.fromTo(c,{opacity:0},{opacity:1,duration:.25,immediateRender:false},at-.45);
 const ex=990+(x<990?-170:170), ey=530+(y<530?-150:150), mx=(x+ex)/2, my=(y+ey)/2+(y<530?-40:40), sx=x+(x<990?140:-140);
 const p=svgEl("path",{d:`M${sx} ${y} Q${mx} ${my} ${ex} ${ey}`},wires);drawOn(p,at-.2,.35);
 tl.to(c,{x:0,y:-7,scale:.03,opacity:0,duration:.45,ease:"power3.in"},at+.1);
 tl.to(p,{opacity:0,duration:.25},at+.45);
 tl.to(`#ph-${app}`,{scale:1,duration:.4,ease:"back.out(2.5)"},at+.45)});
fadeOut(a5,C.absorb-.2);

/* ---------------- 05  What else did it swallow? ---------------- */
ask(5,"What else did it swallow?",C.absorb,C.danBig);
const hubX=990,hubY=523;
[340,470].forEach((r,i)=>{const o=svgEl("circle",{class:"orbit",cx:hubX,cy:hubY,r},wires);
 tl.fromTo(o,{opacity:0,attr:{r:r*.5}},{opacity:1,attr:{r},duration:.9,ease:"power2.out"},C.internet+i*.12);
 tl.to(o,{rotation:i?-40:40,svgOrigin:`${hubX} ${hubY}`,duration:D-C.internet,ease:"none"},C.internet);
 tl.to(o,{opacity:0,duration:.4},C.danBig-.35)});
const nodes=[["internet","Internet",990,150],["money","Money",1530,250],["ai","AI",1640,523],["news","News",1530,800],["friends","Friends",990,960],["travel","Travel",470,800],["business","Business",450,250]];
nodes.forEach(([k,label,x,y])=>{const at=C[k];
 const dx=x-hubX,dy=y-hubY,len=Math.hypot(dx,dy),ux=dx/len,uy=dy/len;
 const p=svgEl("path",{d:`M${hubX+ux*240} ${hubY+uy*330} L${x-ux*100} ${y-uy*55}`,"stroke-opacity":.6},wires);
 drawOn(p,at,.35);
 const icon=$(`#ph-${k}`).outerHTML.replace(/id="ph-/,'id="chip-');
 const n=el(`<div class="chip ${k==="ai"?"ai":""}" style="left:${x}px;top:${y}px"><span class="ic"><svg viewBox="-34 -34 68 68">${icon}</svg></span>${label}</div>`);
 const g0=n.querySelector("g");g0.removeAttribute("style");g0.removeAttribute("transform");g0.removeAttribute("class");
 tl.set(n,{xPercent:-50,yPercent:-50},0);
 tl.fromTo(n,{opacity:0,scale:.4},{opacity:1,scale:1,duration:.45,ease:"back.out(2.2)"},at+.08);
 tl.to(`#ph-${k}`,{scale:1,duration:.4,ease:"back.out(2.5)"},at+.05);
 tl.to(`#ph-l-${k}`,{opacity:1,duration:.3},at+.2);
 tl.to([n,p],{opacity:0,duration:.35},C.danBig-.35)});
tl.to([PH,glow],{opacity:0,scale:.7,y:-40,duration:.55,ease:"power2.in"},C.danBig-.2);

/* ---------------- 06  Who's asking? ---------------- */
ask(6,"Who’s asking?",C.danBig+.3,C.danBack);
const glass=$("#glass"), roles=glass.querySelectorAll(".role span"), items=glass.querySelectorAll(".it");
tl.fromTo(glass,{opacity:0,x:-80},{opacity:1,x:0,duration:.8,ease:"power3.out"},C.dan-.2);
tl.fromTo(glass.querySelector("h1"),{opacity:0,y:30},{opacity:1,y:0,duration:.6,ease:"power3.out"},C.dan);
tl.fromTo(roles[0],{opacity:0,y:16},{opacity:1,y:0,duration:.45},C.entre);
tl.fromTo(roles[1],{opacity:0,y:16},{opacity:1,y:0,duration:.45},C.loveAI);
tl.fromTo(glass.querySelector(".comm small"),{opacity:0},{opacity:1,duration:.4},C.community);
["easier","ownbiz","independent"].forEach((k,i)=>{tl.fromTo(items[i],{opacity:0,x:-20},{opacity:1,x:0,duration:.4,ease:"back.out(2)"},C[k]-.15);drawOn(items[i].querySelector("path"),C[k]+.15,.4)});
tl.to(glass,{opacity:0,x:-80,duration:.5,ease:"power2.in"},C.danBack-.1);

/* ---------------- 07  Never this rich ---------------- */
const rich=$("#rich"), rh=rich.querySelector("h1");
rh.innerHTML="We have never been <em>this rich.</em>".replace(/(<em>.*<\/em>)|(\S+)/g,(m,em,w)=>em?`<span>${em}</span>`:`<span>${w}</span>`);
tl.to(rh.querySelectorAll("span"),{opacity:1,duration:.25,stagger:.12},C.danBack+.3);
tl.fromTo(rh.querySelector("span:last-child"),{scale:.8},{scale:1,duration:.5,ease:"back.out(2)"},C.rich);
const cards=rich.querySelectorAll(".row div");
["school","info","resources"].forEach((k,i)=>tl.fromTo(cards[i],{opacity:0,y:40,rotation:(i-1)*4},{opacity:1,y:0,rotation:(i-1)*2,duration:.45,ease:"back.out(2)"},C[k]));
const dr=hand("→ to make our dreams real.",760,760,C.dreams-.3,{rot:-3,size:62});
tl.to([rich,dr[0]],{opacity:0,y:-30,duration:.5},C.wallIn-.1);

/* ---------------- 08  Today's subject ---------------- */
ask(7,"How did one become all?",C.wallIn+.1,C.title+.1);
// the series mark: Then | Now — the two halves meet on the amber cut
const mk=el(`<div id="markwrap" style="position:absolute;left:50%;top:120px;width:240px;height:240px;margin-left:-120px;z-index:31;opacity:0"><svg id="mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 240" width="240" height="240">
 <defs><clipPath id="mkL"><rect x="0" y="0" width="120" height="240"/></clipPath><clipPath id="mkR"><rect x="120" y="0" width="120" height="240"/></clipPath></defs>
 <g clip-path="url(#mkL)"><circle cx="120" cy="120" r="112" fill="#ece0c9"/><circle cx="120" cy="120" r="96" fill="#2a1a10"/><circle cx="96.1" cy="185.8" r="15" fill="#ece0c9"/><circle cx="66.4" cy="165.0" r="15" fill="#ece0c9"/><circle cx="51.1" cy="132.2" r="15" fill="#ece0c9"/><circle cx="54.2" cy="96.1" r="15" fill="#ece0c9"/><circle cx="75.0" cy="66.4" r="15" fill="#ece0c9"/><circle cx="120" cy="120" r="30" fill="#ece0c9"/><circle cx="120" cy="120" r="8" fill="#b33a2b"/></g>
 <g clip-path="url(#mkR)"><circle cx="120" cy="120" r="112" fill="#0d1017"/>
  <g fill="#3ee08f"><rect x="138" y="66" width="24" height="24" rx="7"/><rect x="172" y="66" width="24" height="24" rx="7"/>
   <rect x="138" y="100" width="24" height="24" rx="7"/><rect x="172" y="100" width="24" height="24" rx="7"/>
   <rect x="138" y="134" width="24" height="24" rx="7"/><rect x="172" y="134" width="24" height="24" rx="7" fill="#f0783c"/>
   <rect x="138" y="172" width="58" height="10" rx="5" opacity=".55"/></g></g>
 <circle cx="120" cy="120" r="112" fill="none" stroke="#8a4a22" stroke-width="4"/>
 <path d="M120 8 L120 232" stroke="#f0783c" stroke-width="4"/>
</svg>
</div>`);
const halves=mk.querySelectorAll("svg > g");
tl.set(mk,{opacity:1},C.wallIn);
tl.fromTo(halves[0],{x:-160,opacity:0},{x:0,opacity:1,duration:.8,ease:"power3.out"},C.wallIn);
tl.fromTo(halves[1],{x:160,opacity:0},{x:0,opacity:1,duration:.8,ease:"power3.out"},C.wallIn);
tl.fromTo(mk.querySelectorAll("svg > circle, svg > path"),{opacity:0},{opacity:1,duration:.3},C.wallIn+.7);
tl.to(halves[0],{rotation:-25,svgOrigin:"120 120",duration:1.2,ease:"power2.inOut"},C.goBack-.2);
tl.to(halves[0],{rotation:0,svgOrigin:"120 120",duration:.6,ease:"steps(5)"},C.goBack+1.0);
const title=$("#title"), h=title.querySelector("h1");
title.querySelector("small").textContent="TODAY’S SUBJECT";
h.innerHTML=`<span>The</span> <em>${[..."Evolution."].map(c=>`<span>${c}</span>`).join("")}</em>`;
tl.set(title,{opacity:1},C.subject-.4);
tl.fromTo(title.querySelector("small"),{opacity:0,y:12},{opacity:1,y:0,duration:.5},C.subject-.4);
tl.fromTo(h.querySelectorAll("span"),{opacity:0,y:60,rotationX:-70},{opacity:1,y:0,rotationX:0,duration:.7,stagger:.045,ease:"power3.out"},C.title);
tl.fromTo("#next",{opacity:0},{opacity:1,duration:.6},C.title+1.0);
const pil=el(`<div id="pillars" style="position:absolute;left:0;right:0;top:720px;display:flex;justify-content:center;gap:22px;z-index:31">${["Technology","Health","Education","Financial education"].map(t=>`<div class="chip" style="position:relative">${t}</div>`).join("")}</div>`);
["pTech","pHealth","pEdu","pFin"].forEach((k,i)=>tl.fromTo(pil.children[i],{opacity:0,y:30},{opacity:1,y:0,duration:.4,ease:"back.out(2)"},C[k]));
tl.to({}, {duration:.01}, D-.01);

/* ---------------- LIFE: 3D float, connecting threads, travelling light ---------------- */
// every card breathes in 3D while it is on screen
function float3d(nodes,from,to,amp=6){nodes.forEach((n,i)=>{const d=2.4+(i%3)*.5, k=Math.max(1,Math.floor((to-from)/d));
 tl.fromTo(n,{rotationX:0,rotationY:0},{rotationX:amp*(i%2?1:-1)*.6,rotationY:amp*(i%2?-1:1),y:"-=6",transformPerspective:900,duration:d/2,ease:"sine.inOut",yoyo:true,repeat:k*2-1,immediateRender:false},from+i*.15)})}
// a light that runs along a path, repeatedly
function pulse(path,from,to,color="#7cf0b5",every=1.4){const L=path.getTotalLength?path.getTotalLength():0;if(!L)return;
 const dot=svgEl("circle",{r:5,fill:color,opacity:0},path.ownerSVGElement);dot.setAttribute("style","filter:drop-shadow(0 0 6px "+color+")");
 for(let t=from;t<to-.8;t+=every){const o={u:0};tl.fromTo(o,{u:0},{u:1,duration:.8,ease:"power1.inOut",immediateRender:false,onUpdate:()=>{const p=path.getPointAtLength(o.u*L);dot.setAttribute("cx",p.x);dot.setAttribute("cy",p.y);dot.setAttribute("opacity",Math.sin(Math.PI*o.u))}},t)}}
// network: pulses from the phone to every node, nodes and phone float
$$("#wires path").forEach(p=>{if(p.getAttribute("stroke-opacity")==".6")pulse(p,C.internet+.5,C.danBig-.4,"#7cf0b5",1.3)});
float3d($$(".chip"),C.internet,C.danBig-.4,7);
tl.fromTo("#art-phone",{rotationY:0},{rotationY:10,transformPerspective:1200,duration:2.2,ease:"sine.inOut",yoyo:true,repeat:Math.max(1,Math.floor((C.danBig-C.present)/2.2)),immediateRender:false},C.present+.6);
// past objects sway gently in 3D while they are lit
[[T,C.phoneIn+1,C.letterIn],[L,C.letterIn+1,C.radioIn],[Rd,C.radioIn+1,C.moonIn-.2],[TT,C.recordIn+1,C.present]].forEach(([n,a,b2])=>{
 tl.fromTo(n,{rotationY:0},{rotationY:5,rotationX:2,transformPerspective:1600,duration:1.6,ease:"sine.inOut",yoyo:true,repeat:Math.max(1,Math.floor((b2-a)/1.6)),immediateRender:false},a)});
// "never this rich": the three cards tilt in from depth, connected by a thread that runs into the dreams line
const rc=[...document.querySelectorAll("#rich .row div")];
const thr=svgEl("svg",{class:"draw",width:1920,height:1080,viewBox:"0 0 1920 1080",style:"left:0;top:0;z-index:30"},root);
const rp=svgEl("path",{d:"M760 560 C 900 640, 1020 480, 1160 560 S 1400 640, 1460 560 M1160 600 Q 1160 700 1100 760","stroke-dasharray":"none"},thr);
rp.style.stroke="#f0783c";rp.style.strokeWidth=3;
drawOn(rp,C.resources+.3,.8);pulse(rp,C.resources+1.1,C.wallIn-.2,"#7cf0b5",1.2);
tl.to(thr,{opacity:0,duration:.4},C.wallIn-.1);
rc.forEach((c,i)=>tl.fromTo(c,{rotationY:-70,z:-300},{rotationY:0,z:0,transformPerspective:900,duration:.7,ease:"power3.out",immediateRender:false},[C.school,C.info,C.resources][i]));
float3d(rc,C.resources+.8,C.wallIn,6);
// the four pillars: flip up in 3D, linked by one thread with light running through it
const pills=[...document.querySelectorAll("#pillars .chip")];
pills.forEach((p,i)=>tl.fromTo(p,{rotationX:-90,transformOrigin:"50% 100%"},{rotationX:0,transformPerspective:700,duration:.6,ease:"back.out(1.6)",immediateRender:false},[C.pTech,C.pHealth,C.pEdu,C.pFin][i]));
const pth=svgEl("svg",{class:"draw",width:1920,height:1080,viewBox:"0 0 1920 1080",style:"left:0;top:0;z-index:30"},root);
const pp=svgEl("path",{d:"M610 752 C 760 800, 880 800, 960 752 S 1180 700, 1320 752"},pth);
pp.style.stroke="#f0783c99";pp.style.strokeWidth=2.5;
drawOn(pp,C.pFin+.3,.9);pulse(pp,C.pFin+1.2,D,"#3ee08f",1.5);
float3d(pills,C.title+.6,D,5);
/* ---------------- the night sky of the present: drifting stars, deterministic per frame ---------------- */
const sky=$("#sky"), sx=sky.getContext("2d");
let seed=20260;const rnd=()=>(seed=(seed*16807)%2147483647)/2147483647;
const stars=[...Array(520)].map((_,i)=>{const layer=i<300?0:i<460?1:2;return{x:rnd()*1920,y:rnd()*1080,r:[.7,1.2,1.9][layer]*(0.7+rnd()*.6),v:[6,14,30][layer],tw:rnd()*6.28,ts:.6+rnd()*2.2,warm:rnd()<.18}});
const shooters=[C.present+1.2,C.internet+.3,C.danBack+.5,C.title+.4].map((t,i)=>({t,x:300+i*420,y:90+i*40}));
function drawSky(t){
 sx.clearRect(0,0,1920,1080);
 const g=sx.createRadialGradient(1150,380,40,1150,380,1100);g.addColorStop(0,"#1b2540");g.addColorStop(.45,"#0d1426");g.addColorStop(1,"#05070c");
 sx.fillStyle=g;sx.fillRect(0,0,1920,1080);
 // faint nebula band
 const n=sx.createLinearGradient(0,900,1920,100);n.addColorStop(0,"#0000");n.addColorStop(.5,"#6a4ea022");n.addColorStop(.62,"#f0783c14");n.addColorStop(1,"#0000");
 sx.fillStyle=n;sx.fillRect(0,0,1920,1080);
 for(const s of stars){const x=((s.x-s.v*t)%1960+1960)%1960-20, y=s.y+Math.sin(t*.05+s.tw)*4;
  const a=.45+.55*Math.abs(Math.sin(t*s.ts+s.tw));
  sx.globalAlpha=a;sx.fillStyle=s.warm?"#ffd9b0":"#e8f2ff";sx.beginPath();sx.arc(x,y,s.r,0,6.283);sx.fill();
  if(s.r>1.8){sx.globalAlpha=a*.25;sx.beginPath();sx.arc(x,y,s.r*3.2,0,6.283);sx.fill()}}
 for(const sh of shooters){const u=(t-sh.t)/.9;if(u<0||u>1)continue;
  const x=sh.x+u*520,y=sh.y+u*210,L=160*(1-Math.abs(u-.5)*1.6);
  const gr=sx.createLinearGradient(x,y,x-L,y-L*.4);gr.addColorStop(0,"#fff");gr.addColorStop(1,"#fff0");
  sx.globalAlpha=1;sx.strokeStyle=gr;sx.lineWidth=2.2;sx.beginPath();sx.moveTo(x,y);sx.lineTo(x-L,y-L*.4);sx.stroke()}
 sx.globalAlpha=1;
}
/* ---------------- per-frame: film grain, projector flicker, guide, slot meter ---------------- */
const guide=$("#guide"), W=TIMING.words, bars=$$("#presenter .meter i"), gnt=$("#gnt"), flick=$("#flicker");
function frame(t){
 gnt.setAttribute("seed",Math.floor(t*24)%97+1);
 drawSky(t);
 flick.style.opacity=(t>C.shrink&&t<C.present)?(.03+.03*Math.abs(Math.sin(t*61.7)*Math.sin(t*23.3))).toFixed(3):0;
 if(guide.dataset.off!=="1"){const cur=W.find(w=>t>=w.s-0.25&&t<=w.e+0.6)||null;
  guide.innerHTML=!cur?"":'<b>GUIDE · DAN’S TAKE</b>'+W.filter(w=>w.line===cur.line).map(w=>`<span class="${t>=w.s&&t<=w.e?"on":""}">${w.w}</span>`).join(" ")}
 bars.forEach((b,i)=>{const sp=W.find(w=>t>=w.s&&t<=w.e);b.style.height=((sp?.35+.65*Math.abs(Math.sin(t*(13+i*3.1)+i*1.7)):.08)*100)+"%"});
}
tl.eventCallback("onUpdate",()=>frame(tl.time()));frame(0);
window.__timelines={"evolution-opening-v4":tl};
</script></body></html>
